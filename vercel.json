{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "icsc-issuer": { "root": ".", "entrypoint": "issuer/app:vercel_app" },
    "icsc-verifier": { "root": ".", "entrypoint": "verifier/app:vercel_app" }
  },
  "rewrites": [
    { "source": "/issuer/:path*", "destination": { "service": "icsc-issuer" } },
    { "source": "/verifier/:path*", "destination": { "service": "icsc-verifier" } },
    { "source": "/holder/:path*", "destination": { "service": "icsc-verifier" } },
    { "source": "/(.*)", "destination": { "service": "icsc-verifier" } }
  ]
}
