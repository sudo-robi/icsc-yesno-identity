# Yes/No Identity - Vercel Deployment Environment Variables
# Copy to .env.local and fill in values

# ============================================================================
# Core Configuration
# ============================================================================

# Issuer identity (appears in credentials and bundles)
ISSUER_ID=NIMC-TEST-01

# Admin token for protected endpoints (generate with: openssl rand -hex 16)
ADMIN_TOKEN=your-admin-token-here

# Credential TTL (seconds) - how long a holder credential is valid
CRED_TTL_SEC=3600

# Enrollment code TTL (seconds)
ENROLL_CODE_TTL_SEC=86400

# Bundle TTL (seconds) - how long a trust bundle is valid (default 7 days)
BUNDLE_TTL_SEC=604800

# OTP Configuration
OTP_ENABLED=true
OTP_STEP_SEC=30
OTP_GRACE_STEPS=1

# Cron secret for bundle sync (generate with: openssl rand -hex 16)
CRON_SECRET=your-cron-secret-here

# ============================================================================
# Database (Vercel Postgres / Neon / Supabase)
# ============================================================================

# POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Get from Vercel Dashboard → Storage → Postgres → Connect → .env.local

# ============================================================================
# Key-Value Store (Vercel KV)
# ============================================================================

# KV_REST_API_URL=https://api.vercel.com/v1/kv/namespace
# KV_REST_API_TOKEN=your-kv-token
# Get from Vercel Dashboard → Storage → KV → Connect → .env.local

# ============================================================================
# Realtime (Ably) - for revocation/rotation push
# ============================================================================

# ABLY_API_KEY=your-ably-api-key
# Get from Ably Dashboard → Apps → API Keys

# ============================================================================
# Optional: Issuer-managed Ed25519 key (if not using auto-generated)
# ============================================================================

# ISSUER_PRIV_HEX=64-char-hex-private-key
# If set, rotation endpoints will refuse to rotate (key managed via env)

# ============================================================================
# Optional: OTP secrets file path (for local dev only, not used on Vercel)
# ============================================================================

# OTP_SECRETS_PATH=./otp_secrets.json

# ============================================================================
# Verifier Configuration (set via admin UI or KV directly)
# ============================================================================

# VERIFIER_ID=SHOP-A
# ISSUER_URL=https://your-issuer.vercel.app
# Set via admin UI or directly in Vercel KV:
# verifier_config = { "verifierId": "SHOP-A", "issuerUrl": "...", "adminToken": "...", "otpEnabled": true }