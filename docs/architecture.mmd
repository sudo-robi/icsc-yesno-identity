%%{init: {"flowchart": {"defaultRenderer": "elk"}}}%%
flowchart TD

node_holder_actor(("Holder"))
node_pairing_actor(("Pairing Operator"))
node_auditor_actor(("Auditor"))

subgraph group_holder["Holder Client"]
  node_holder_ui["Holder App<br/>[holder/index.html]"]
end

subgraph group_issuance["Credential Issuance"]
  node_issuer_api["Issuer Service<br/>[issuer/app.py]"]
  node_issuer_records[("Issuer Records<br/>[issuer/app.py]")]
  node_issuer_keys[("Issuer Key Store<br/>[issuer/app.py]")]
end

subgraph group_verification["Offline Verification"]
  node_verifier_api["Verifier Routes<br/>[verifier/app.py]"]
  node_decision_engine["Decision Engine<br/>[verifier/app.py]"]
  node_challenge_nonces[("Challenge Nonces<br/>[verifier/app.py]")]
  node_trust_bundle[("Trust Bundle<br/>[verifier/app.py]")]
end

subgraph group_audit["Audit And Fallback"]
  node_otp_handler["OTP Fallback<br/>[verifier/app.py]"]
  node_otp_state[("Used Code Store<br/>[verifier/app.py]")]
  node_otp_secrets[("OTP Secrets<br/>[verifier/app.py]")]
  node_receipt_ledger[("Receipt Ledger<br/>[verifier/app.py]")]
  node_receipt_api["Receipt Export<br/>[verifier/app.py]"]
end

subgraph group_shared["Shared Libraries"]
  node_crypto["Crypto Primitives<br/>[shared/crypto.py]"]
  node_schemas["Data Contracts<br/>[shared/schemas.py]"]
end

%% Holder <-> Issuer
node_holder_actor -->|"uses"| node_holder_ui
node_holder_ui -->|"requests credential"| node_issuer_api
node_issuer_api -->|"returns credential"| node_holder_ui
node_issuer_api -->|"reads user"| node_issuer_records
node_issuer_api -->|"loads keys"| node_issuer_keys

%% Trust distribution (out-of-band)
node_issuer_api -->|"publishes signed bundle<br/>[/bundle]"| node_pairing_actor
node_pairing_actor -->|"syncs bundle"| node_verifier_api
node_verifier_api -->|"writes bundle"| node_trust_bundle
node_verifier_api -->|"writes secrets"| node_otp_secrets

%% Verification flow (numbered)
node_holder_ui -->|"1. requests challenge"| node_verifier_api
node_holder_ui -->|"2. submits credential"| node_verifier_api
node_verifier_api -->|"3. returns result"| node_holder_ui
node_verifier_api -->|"generates nonce"| node_challenge_nonces
node_verifier_api -->|"dispatches check"| node_decision_engine
node_decision_engine -->|"reads trust"| node_trust_bundle
node_decision_engine -->|"checks nonce"| node_challenge_nonces
node_verifier_api -->|"writes receipt"| node_receipt_ledger

%% OTP fallback
node_verifier_api -->|"dispatches OTP"| node_otp_handler
node_otp_handler -->|"reads OTP secrets"| node_otp_secrets
node_otp_handler -->|"checks reuse"| node_otp_state
node_otp_handler -->|"writes receipt"| node_receipt_ledger

%% Audit
node_auditor_actor -->|"requests export"| node_receipt_api
node_receipt_api -->|"reads receipts"| node_receipt_ledger

%% Shared library dependencies (dotted = compile/import-time use)
node_issuer_api -.->|"signs"| node_crypto
node_decision_engine -.->|"verifies"| node_crypto
node_otp_handler -.->|"computes code"| node_crypto
node_issuer_api -.->|"builds + asserts"| node_schemas
node_verifier_api -.->|"validates via"| node_schemas

