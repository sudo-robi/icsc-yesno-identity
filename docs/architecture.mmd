%%{init: {"flowchart": {"defaultRenderer": "elk"}}}%%
flowchart TD

node_operator(("Operator"))
node_holder_actor(("Holder"))
node_auditor(("Auditor"))

subgraph group_holder["Holder PWA"]
  node_holder_ui["Holder App<br/>[holder/app.js]"]
  node_holder_keys[("Device P-256 Keys per shop<br/>[IndexedDB]")]
end

subgraph group_issuance["Credential Issuance"]
  node_issuer_api["Issuer Routes<br/>[issuer/app.py]"]
  node_issuer_svc["Enrollment + Bundle + Rotation<br/>[issuer/services.py]"]
  node_issuer_records[("Users + Codes + Keys<br/>[issuer/repo.py]")]
end

subgraph group_verification["Offline Verification"]
  node_challenge["Challenge QR {n,vid,exp}<br/>[verifier/app.py challenge]"]
  node_verifier_api["Verifier Routes<br/>[verifier/app.py]"]
  node_decision_engine["Decision Engine decide()<br/>[verifier/services.py]"]
  node_nonce_store[("Nonces atomic single-use<br/>[verifier/repo.py]")]
  node_trust_bundle[("Pinned Trust Bundle<br/>[verifier/repo.py]")]
end

subgraph group_audit["Audit+Fallback"]
  node_otp_handler["OTP Fallback verify_code<br/>[verifier/app.py]"]
  node_otp_match["OTP Match + Status<br/>[verifier/services.py]"]
  node_otp_state[("Used Codes sub,step<br/>[verifier/repo.py]")]
  node_otp_secrets[("OTP Secrets 0600 file<br/>[otp_secrets.json]")]
  node_receipt_ledger[("Receipt Ledger HMAC chain<br/>[verifier/repo.py]")]
  node_receipt_api["Receipt Export<br/>[verifier/app.py receipts]"]
end

subgraph group_shared["Shared Libraries"]
  node_crypto["Crypto Ed25519/P-256/HMAC<br/>[shared/crypto.py]"]
  node_schemas["Contracts + Reason Codes<br/>[shared/schemas.py]"]
  node_canonical["Canonical JSON<br/>[shared/canonical.py]"]
end

%% Enrollment - one time, online
node_operator -->|"mints single-use code"| node_issuer_api
node_holder_actor -->|"uses"| node_holder_ui
node_holder_ui -->|"generates P-256 key"| node_holder_keys
node_holder_ui -->|"POST /enroll {code,vid,holder_pub}"| node_issuer_api
node_issuer_api -->|"issue_credential()"| node_issuer_svc
node_issuer_svc -->|"reads user + keys"| node_issuer_records
node_issuer_svc -->|"returns credential + otp_secret"| node_holder_ui

%% Trust distribution - out-of-band, signed
node_issuer_svc -->|"build_bundle() signed"| node_operator
node_operator -->|"POST /sync + admin token"| node_verifier_api
node_verifier_api -->|"check_bundle() TOFU then pin"| node_trust_bundle

%% Verification flow - numbered, fully offline
node_verifier_api -->|"1. shows challenge {n,vid,exp}"| node_challenge
node_holder_ui -->|"2. scans challenge"| node_challenge
node_holder_ui -->|"3. signs proof on-device"| node_holder_keys
node_holder_ui -->|"4. shows {c,p} QR"| node_verifier_api
node_verifier_api -->|"dispatches check"| node_decision_engine
node_decision_engine -->|"reads trust revoked/minors"| node_trust_bundle
node_decision_engine -->|"consumes nonce atomic"| node_nonce_store
node_verifier_api -->|"5. YES/NO + reason"| node_holder_actor
node_verifier_api -->|"writes receipt"| node_receipt_ledger

%% OTP fallback
node_verifier_api -->|"dispatches OTP"| node_otp_handler
node_otp_handler -->|"match_otp_code()"| node_otp_match
node_otp_match -->|"reads sub-to-secret map"| node_otp_secrets
node_otp_handler -->|"checks reuse"| node_otp_state
node_otp_handler -->|"writes receipt"| node_receipt_ledger

%% Audit
node_auditor -->|"requests export"| node_receipt_api
node_receipt_api -->|"reads receipts"| node_receipt_ledger

%% Shared library dependencies - dotted = import-time use
node_issuer_svc -.->|"signs + pseudonym"| node_crypto
node_decision_engine -.->|"verifies"| node_crypto
node_otp_match -.->|"computes code"| node_crypto
node_issuer_svc -.->|"validates via"| node_schemas
node_verifier_api -.->|"validates via"| node_schemas
node_issuer_svc -.->|"canonical bytes"| node_canonical
node_decision_engine -.->|"canonical bytes"| node_canonical

